# 이 파일을 .env 로 복사해서 채운다 (.env 는 커밋하지 않는다)
# 원본 MariaDB — 읽기 전용 계정
MARIADB_DSN=
# Knowledge Graph DB (PostgreSQL)
# KG_PG_DSN=postgres://user:password@host:5432/dbname

# ── PostgreSQL ──────────────────────────────────────
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

ANTHROPIC_API_KEY=
# 키가 워크스페이스에 묶여 있지 않으면 필요 (Console > Workspaces 의 ID)
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=

# 선택 (기본값)
# CONCEPT_TABLE=mathdb.math_concepts
# TOP_K=10
# CONF_THRESHOLD=0.8
# DRY_RUN=true
# BUDGET_USD=20
# CONCURRENCY=4
# EFFORT=medium            # Claude 판정 effort (low|medium|high|xhigh|max)
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_THINKING_BUDGET=2048
# CLAUDE_FALLBACKS=true    # 거절 시 서버측 fallback (계정에서 지원 안 하면 false)
# MERGE_COSINE=0.92        # 단계 0 임베딩 코사인 중복 기준
# ACHIEVEMENT_FILE=        # 단원별 성취기준 JSON (README 참고). KG 에 성취기준이 없을 때만
